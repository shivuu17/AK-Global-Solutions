# ==============================================================================
# AK GLOBAL SOLUTIONS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, set these variables in your Vercel / Firebase Hosting Project Settings.
# NOTE: Never commit .env or .env.local containing real production secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE WEB CONFIGURATION (Client SDK)
# Find these in Firebase Console > Project Settings > General > Your Apps > Web app
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=ak-global-solutions.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ak-global-solutions
VITE_FIREBASE_STORAGE_BUCKET=ak-global-solutions.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHORIZATION & SECURITY
# Comma-separated list of authorized administrator emails.
# Only users with these emails who authenticate via Firebase Auth will be granted access.
# ------------------------------------------------------------------------------
VITE_ADMIN_EMAILS=akglobalsolutions@gmail.com,admin@akglobalsolutions.in

# ------------------------------------------------------------------------------
# 3. CLOUDINARY CONFIGURATION (Free Media Storage & CDN)
# Find these in your Cloudinary Dashboard: https://console.cloudinary.com/
# ------------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# For direct browser uploads from the admin dashboard:
# Create an Unsigned Upload Preset in Cloudinary Settings > Upload > Upload Presets
VITE_CLOUDINARY_UPLOAD_PRESET=ak_global_admin_preset

# Optional: If using Vercel Serverless Signed Uploads (/api/cloudinary-sign):
# Set this ONLY in Vercel Serverless Environment Variables (NEVER with VITE_ prefix!)
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

